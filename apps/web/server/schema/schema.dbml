enum user_role {
	ADMIN
	USER
}



enum taiwan_area {
	NORTHERN
	CENTRAL
	SOUTHERN
	EASTERN
	ISLANDS
}



enum seat_type {
	STANDING
	SEATED
	ACCESSIBLE
}



enum distance {
	FAR
	MIDDLE
	NEAR
}



enum aircon_strength {
	HOT
	COMFORT
	COLD
}



enum venue_status {
	DRAFT
	PUBLISHED
}

Table users [headercolor: #175e7a] {
	id uuid [ pk ]
	email text [ not null ]
	username text
	password text
	picture text
	role user_role [ not null, default: 'USER' ]
	created_at timestamptz [ not null, default: `now()` ]
	updated_at timestamptz [ not null, default: `now()` ]
	metadata jsonb

	Indexes {
		email [name: 'idx_users_email']
	}
}

Table venues [headercolor: #175e7a] {
	id uuid [ pk ]
	name text [ not null ]
	status venue_status
	created_at timestamptz [ not null, default: `now()` ]
	updated_at timestamptz [ not null, default: `now()` ]
	area taiwan_area
	address text
	restricted_view text
	seat_count integer
	locker_count integer
	traffic_guide text
}

Table contributions [headercolor: #175e7a] {
	id uuid [ pk ]
	venue_id uuid [ not null ]
	user_id uuid [ not null ]
	seat_id uuid [ not null ]
	concert_name text
	satisfaction decimal(2, 1)
	is_restricted_area boolean
	can_pick_ribbon boolean
	is_aisle_seat boolean
	exit_distance distance
	dismissal_time integer [ note: '分鐘' ]
	aircon_strength aircon_strength
	aircon_comment text
	comment text
	created_at timestamptz [ not null, default: `now()` ]
	updated_at timestamptz [ not null, default: `now()` ]

	Indexes {
		venue_id [name: 'idx_contributions_venue_id']
		user_id [name: 'idx_contributions_user_id']
		created_at [name: 'idx_contributions_created_at']
	}

	Note: 'seat_area 對應 seat_maps 裡的 area 選項'
}

Table files [headercolor: #175e7a] {
	id uuid [ pk ]
	user_id uuid [ not null ]
	url text [ not null ]
	file_name text [ not null ]
	created_at timestamptz [ not null, default: `now()` ]
	updated_at timestamptz [ not null, default: `now()` ]

	Indexes {
		user_id [name: 'idx_files_user_id']
	}
}

Table seat_maps [headercolor: #175e7a] {
	id uuid [ pk ]
	venue_id uuid [ not null ]
	map_svg text [ not null ]
	created_at timestamptz [ not null, default: `now()` ]
	updated_at timestamptz [ not null, default: `now()` ]
}

Table seat_areas [headercolor: #175e7a] {
	id uuid [ pk ]
	seat_map_id uuid [ not null ]
	area_label text [ not null ]
	created_at timestamptz [ not null, default: `now()` ]

	Indexes {
		seat_map_id [name: 'idx_seat_areas_map']
	}
}

Table restrooms [headercolor: #175e7a] {
	id uuid [ pk ]
	male_count integer
	female_count integer
	disability_count integer
	comment text
	venue_id uuid [ not null ]
	created_at timestamptz [ not null, default: `now()` ]
	updated_at timestamptz [ not null, default: `now()` ]
}

Table contribution_images [headercolor: #175e7a] {
	id uuid [ pk ]
	contribution_id uuid [ not null ]
	device_name text
	file_id_with_watermark uuid [ not null ]
	file_id_without_watermark uuid
	created_at timestamptz [ not null, default: `now()` ]
	updated_at timestamptz [ not null, default: `now()` ]
}

Table seats [headercolor: #175e7a] {
	id uuid [ pk ]
	venue_id uuid [ not null ]
	seat_area uuid [ not null ]
	seat_row text [ not null ]
	seat_label text [ not null ]
	seat_type seat_type
	created_at timestamptz [ not null, default: `now()` ]
	updated_at timestamptz [ not null, default: `now()` ]

	Indexes {
		venue_id [name: 'idx_seats_venue_id']
		(seat_area, seat_row) [name: 'idx_seats_area_row']
		seat_area [name: 'idx_seats_area']
	}
}

Ref fk_seat_areas_seat_map {
	seat_areas.seat_map_id > seat_maps.id [ delete: cascade, update: cascade ]
}

Ref fk_seats_seat_area {
	seats.seat_area > seat_areas.id [ delete: no action, update: no action ]
}

Ref fk_contributions_venue_id_venues {
	venues.id < contributions.venue_id [ delete: no action, update: no action ]
}

Ref fk_users_id_files {
	users.id < files.user_id [ delete: no action, update: no action ]
}

Ref fk_venues_id_seat_maps {
	venues.id - seat_maps.venue_id [ delete: no action, update: no action ]
}

Ref fk_venues_id_restrooms {
	venues.id - restrooms.venue_id [ delete: no action, update: no action ]
}

Ref fk_users_id_contributions {
	users.id < contributions.user_id [ delete: no action, update: no action ]
}

Ref fk_image_files_file_id_files {
	contribution_images.file_id_with_watermark - files.id [ delete: no action, update: no action ]
}

Ref fk_image_files_file_id_without_watermark_files {
	contribution_images.file_id_without_watermark - files.id [ delete: no action, update: no action ]
}

Ref fk_seats_venue_id_venues {
	seats.venue_id > venues.id [ delete: no action, update: no action ]
}

Ref fk_contributions_seat_id_seats {
	contributions.seat_id > seats.id [ delete: no action, update: no action ]
}

Ref fk_image_files_contribution_id_contributions {
	contribution_images.contribution_id > contributions.id [ delete: no action, update: no action ]
}
